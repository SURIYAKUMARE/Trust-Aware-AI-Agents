# ==========================================
# TrustAgent Configuration Environment File
# ==========================================

# LLM Provider Configuration ("mock", "gemini", "anthropic")
LLM_PROVIDER=mock
MODEL_NAME=gemini-2.5-flash

# API Keys (optional when LLM_PROVIDER=mock)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Storage & Knowledge Base
DATABASE_URL=sqlite:///./trustagent.db
KB_DIR=./backend/data/kb
CALIBRATOR_PATH=./eval/results/calibrator.pkl

# Decision Router Thresholds
HIGH_THRESHOLD=0.85
MEDIUM_THRESHOLD=0.65
LOW_THRESHOLD=0.45
VERY_LOW_THRESHOLD=0.30

# Multi-Signal Confidence Scorer Weights (Sum to 1.0)
WEIGHT_CONSISTENCY=0.35
WEIGHT_EVIDENCE=0.30
WEIGHT_VERBALIZED=0.20
WEIGHT_REASONING=0.15

# Drift Monitoring Threshold
DRIFT_ECE_THRESHOLD=0.10
MAX_ROUTING_LOOPS=3
