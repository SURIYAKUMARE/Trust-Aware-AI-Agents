# ===============================================
# TrustGuard AI Professional Platform Environment
# ===============================================

# LLM Provider Configuration ("mock", "gemini", "openai", "anthropic")
LLM_PROVIDER=mock
MODEL_NAME=gemini-2.5-flash

# API Keys (Configure server-side or via Client Settings Modal)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Sightengine AI-Generated Image Detection API Credentials
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=

# Storage, Database & RAG Vector Knowledge Base
DATABASE_URL=sqlite:///./trustagent.db
KB_DIR=./backend/data/kb
CALIBRATOR_PATH=./eval/results/calibrator.pkl

# Decision Router Thresholds
HIGH_THRESHOLD=0.85
MEDIUM_THRESHOLD=0.65
LOW_THRESHOLD=0.45
VERY_LOW_THRESHOLD=0.30

# Multi-Signal Confidence Scorer Weights (Sum to 1.0)
WEIGHT_CONSISTENCY=0.35
WEIGHT_EVIDENCE=0.30
WEIGHT_VERBALIZED=0.20
WEIGHT_REASONING=0.15

# Drift Monitoring & System Routing Bounds
DRIFT_ECE_THRESHOLD=0.10
MAX_ROUTING_LOOPS=3

# Frontend Server
PORT=5173
VITE_API_BASE=/api
